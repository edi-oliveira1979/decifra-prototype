# Normaliza final de linha (LF) para arquivos de texto comuns
*.js   text eol=lf
*.ts   text eol=lf
*.jsx  text eol=lf
*.tsx  text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.css  text eol=lf
*.html text eol=lf
*.go   text eol=lf
*.sh   text eol=lf

# Garante LF nos exemplos de env (evita avisos)
.env.example         text eol=lf
backend/.env.example text eol=lf